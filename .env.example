# ─────────────────────────────────────────────────────────────────────────────
# PhotoCut Studio — variables de entorno (Vite)
#
# TODAS son de BUILD y quedan embebidas en el bundle del cliente: NO pongas
# secretos acá (un DSN/ID público está bien; una API key privada NO).
# En Vercel se cargan en Project Settings → Environment Variables.
# Copiá este archivo a `.env` y completá lo que necesites (`.env` no se versiona).
# ─────────────────────────────────────────────────────────────────────────────

# ── Sitio / SEO ──────────────────────────────────────────────────────────────
# Origen público del sitio, SIN barra final. Hace absolutos og:url, canonical y
# og:image — necesario para las previsualizaciones al compartir (WhatsApp,
# Twitter/X) y para SEO. Sin esta variable esas URLs quedan relativas.
# Arrancá con la URL de Vercel y cambiala al dominio propio cuando lo tengas.
# VITE_SITE_URL=https://photocut.vercel.app

# Repo de GitHub del que el modal "Descargar app" lee las releases de escritorio.
VITE_GH_REPO=gabiMaglia/PhotoCutOnline

# ── Donaciones ───────────────────────────────────────────────────────────────
# Link del botón de donación (Ko-fi). Vacío ("") oculta los botones.
# Si no la definís, igual usa este Ko-fi por defecto.
VITE_DONATE_URL=https://ko-fi.com/gabrielmaglia

# ── Publicidad ───────────────────────────────────────────────────────────────
# Un solo proveedor a la vez (prioridad: EthicalAds → Carbon → AdSense).
# Sin ninguno definido, el slot muestra el house-ad propio (cero terceros).
#
# EthicalAds (sin cookies, privacy-first):
# VITE_ETHICALADS_PUBLISHER=tu-publisher-id
#
# Carbon Ads:
# VITE_CARBON_SERVE=XXXXXXXXXXXXXXXX
# VITE_CARBON_PLACEMENT=tudominio
#
# Google AdSense (requiere CMP de consentimiento activado en la consola):
# VITE_ADSENSE_CLIENT=ca-pub-0000000000000000
# VITE_ADSENSE_SLOT=0000000000
#
# Mostrar el slot también en `npm run dev` para previsualizarlo:
# VITE_ADS_DEV=1

# ── Analítica de tráfico (Google Analytics 4) ────────────────────────────────
# ID de medición de GA4. Sin esto no se carga nada. Mide visitas y eventos de
# conversión (recorte hecho, exportación, ZIP de iconos) para monetizar.
# Nota: GA4 usa cookies → en la UE requiere banner de consentimiento (el CMP de
# AdSense, al activarlo, también cubre GA).
# VITE_GA_ID=G-XXXXXXXXXX

# ── Telemetría de errores (opcional) ─────────────────────────────────────────
# DSN público de Sentry; sin esto no se envía nada. Jamás incluye imágenes.
# VITE_SENTRY_DSN=https://xxxxxxxx@oXXXXXX.ingest.sentry.io/XXXXXXX
# Etiqueta de versión en los reportes (si no, usa "dev"):
# VITE_APP_VERSION=0.1.0
